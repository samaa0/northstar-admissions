{
  "name": "northstar-admissions",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,yellow \"node server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "vitest run",
    "benchmark": "node scripts/benchmark.mjs",
    "db:reset": "node scripts/reset-database.mjs",
    "model:catalogue": "node scripts/generate-model-catalogue.mjs",
    "submission:build": "node scripts/build-submission.mjs --replace",
    "cloud:backup": "node --env-file=.env.local scripts/backup-cloud-database.mjs",
    "cloud:migrate": "node --env-file=.env.local scripts/migrate-cloud-database.mjs",
    "cloud:seed": "node --env-file=.env.local scripts/sync-cloud-database.mjs",
    "cloud:sync": "node --env-file=.env.local scripts/sync-cloud-database.mjs",
    "cloud:verify": "node --env-file=.env.local scripts/verify-cloud.mjs",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/source-serif-4": "^5.2.8",
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "lucide-react": "^0.542.0",
    "motion": "^13.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^30.0.1",
    "supertest": "^7.1.4",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
